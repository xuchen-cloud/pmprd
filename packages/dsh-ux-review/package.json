{
  "name": "dsh-ux-review",
  "version": "0.1.12",
  "description": "单文件 UX / PRD 评审与 DeepSeek Harness 修改工作台",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "skills",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "dsh": "0.2.2-rc.3",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.2-rc.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "pack:plugin": "npm run build && npm pack"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xinyuefangfang/pmprd.git",
    "directory": "packages/dsh-ux-review"
  }
}
