{
  "name": "ux-review-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 7792 --strictPort",
    "build": "npm run build:review && vite build",
    "test": "node --test tests/*.test.mjs",
    "build:review": "node scripts/build-review.mjs",
    "test:preview": "node --test tests/preview.test.mjs",
    "test:export": "npm run build:review && node --test tests/export.test.mjs"
  },
  "dependencies": {
    "@tiptap/core": "3.31.0",
    "@tiptap/extension-heading": "3.31.0",
    "@tiptap/extension-highlight": "3.31.0",
    "@tiptap/extension-image": "3.31.0",
    "@tiptap/extension-table": "3.31.0",
    "@tiptap/extension-task-item": "3.31.0",
    "@tiptap/extension-task-list": "3.31.0",
    "@tiptap/markdown": "3.31.0",
    "@tiptap/pm": "3.31.0",
    "@tiptap/react": "3.31.0",
    "@tiptap/starter-kit": "3.31.0",
    "dompurify": "^3.3.0",
    "lucide-react": "^1.73.0",
    "marked": "^16.4.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "playwright": "1.56.1",
    "vite": "7.3.8"
  },
  "overrides": {
    "@tiptap/extension-bubble-menu": "3.31.0",
    "@tiptap/extension-floating-menu": "3.31.0"
  }
